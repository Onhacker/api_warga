APP_ENV=production
APP_URL=https://api-warga-smartdesa.mediaverse.co.id/
APP_TIMEZONE=Asia/Makassar
APP_KEY=replace-with-a-random-secret-at-least-32-characters
API_DEMO_MODE=0
API_SIGNATURE_TTL=300
API_MAX_BODY_BYTES=2097152
WARGA_ALLOWED_ORIGIN=https://warga-smartdesa.mediaverse.co.id
PRIVATE_STORAGE_PATH=/home/USER/smartdesa-private/warga

# Bootstrap universal untuk menghubungkan aplikasi desa tanpa kode manual.
# Nilainya harus sama dengan SMARTDESA_WARGA_AUTO_ENROLL_* pada builder.
WARGA_AUTO_ENROLL_ENABLED=0
WARGA_AUTO_ENROLL_KEY=
WARGA_AUTO_ENROLL_SECRET=
WARGA_AUTO_ENROLL_TTL=300

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smartdesa_warga_api
DB_PASS=ganti-dengan-password-database
DB_NAME=smartdesa_warga
